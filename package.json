{
  "name": "golden-raspberry-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Golden Raspberry Awards API and Angular dashboard",
  "engines": {
    "node": ">=22.9"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @golden-raspberry/api",
    "dev:web": "npm start --workspace @golden-raspberry/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,js,json,md,html,css,yml,yaml}": "prettier --write"
  }
}
